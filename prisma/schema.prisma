// Pharmacy / Medical Store schema
// Stock is always stored in BASE UNITS (e.g. tablets). A medicine has a pack
// (e.g. Strip) containing `unitsPerPack` base units (e.g. 10 tablets).
// Prices on batches are stored PER PACK; per-unit price = pack price / unitsPerPack.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PHARMACIST
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  CREDIT
}

enum MovementType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT
  EXPIRED
}

enum LedgerType {
  PURCHASE // we owe supplier more
  PURCHASE_RETURN // we owe supplier less
  SUPPLIER_PAYMENT // we paid supplier
  CREDIT_SALE // customer owes us more
  SALE_RETURN // customer owes us less
  CUSTOMER_PAYMENT // customer paid us
  OPENING
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales           Sale[]
  purchases       Purchase[]
  saleReturns     SaleReturn[]
  purchaseReturns PurchaseReturn[]
  movements       StockMovement[]
  expenses        Expense[]
  ledgerEntries   LedgerEntry[]
}

// Per-pharmacy branding & preferences. Exactly one row (id = 1) per database.
model StoreSetting {
  id                Int       @id @default(1)
  storeName         String    @default("Medical Store")
  tagline           String    @default("")
  address           String    @default("")
  phone             String    @default("")
  email             String    @default("")
  licenseNo         String    @default("")
  ntn               String    @default("")
  brandColor        String    @default("#059669") // hex, drives the whole UI theme
  logo              Bytes? // stored in DB so it moves with the data (Neon -> local)
  logoMime          String?
  logoUpdatedAt     DateTime?
  showLogoOnReceipt Boolean   @default(true)
  receiptFooter     String    @default("Thank you! Medicines once sold can be returned within 7 days with receipt.")
  nearExpiryDays    Int       @default(90)
  allowNegative     Boolean   @default(false)
  setupCompletedAt  DateTime?
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  medicines Medicine[]
}

model Manufacturer {
  id        String     @id @default(cuid())
  name      String     @unique
  medicines Medicine[]
}

model Medicine {
  id                   String        @id @default(cuid())
  name                 String
  genericName          String?
  form                 String        @default("Tablet") // Tablet, Capsule, Syrup, Injection...
  strength             String? // 500mg, 5ml...
  barcode              String?       @unique
  categoryId           String?
  category             Category?     @relation(fields: [categoryId], references: [id])
  manufacturerId       String?
  manufacturer         Manufacturer? @relation(fields: [manufacturerId], references: [id])
  unitName             String        @default("Tablet") // smallest sellable unit
  packName             String        @default("Strip")
  unitsPerPack         Int           @default(1)
  allowLooseSale       Boolean       @default(true)
  salePrice            Decimal       @default(0) @db.Decimal(12, 2) // default price per pack
  reorderLevel         Int           @default(0) // in base units
  rackLocation         String?
  requiresPrescription Boolean       @default(false)
  isControlled         Boolean       @default(false)
  active               Boolean       @default(true)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  batches       Batch[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  movements     StockMovement[]

  @@index([name])
  @@index([genericName])
}

model Batch {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  batchNo    String
  expiryDate DateTime @db.Date
  costPrice  Decimal  @db.Decimal(12, 2) // per pack (net, after discount & bonus)
  salePrice  Decimal  @db.Decimal(12, 2) // per pack (MRP / retail)
  quantity   Int      @default(0) // remaining base units
  createdAt  DateTime @default(now())

  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  movements           StockMovement[]
  purchaseReturnItems PurchaseReturnItem[]

  @@unique([medicineId, batchNo])
  @@index([expiryDate])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  address       String?
  balance       Decimal  @default(0) @db.Decimal(12, 2) // amount we owe them
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  ledgerEntries   LedgerEntry[]
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  address     String?
  balance     Decimal  @default(0) @db.Decimal(12, 2) // amount they owe us
  creditLimit Decimal  @default(0) @db.Decimal(12, 2) // 0 = no limit
  createdAt   DateTime @default(now())

  sales         Sale[]
  ledgerEntries LedgerEntry[]
}

model Purchase {
  id         String   @id @default(cuid())
  number     Int      @unique @default(autoincrement())
  invoiceNo  String? // supplier's bill number
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  date       DateTime @default(now())
  subtotal   Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  tax        Decimal  @default(0) @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  paid       Decimal  @default(0) @db.Decimal(12, 2)
  note       String?
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  items   PurchaseItem[]
  returns PurchaseReturn[]

  @@index([date])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id])
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id])
  packs       Int
  bonusPacks  Int      @default(0)
  costPrice   Decimal  @db.Decimal(12, 2) // per pack, as on bill
  salePrice   Decimal  @db.Decimal(12, 2) // per pack
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
}

model Sale {
  id            String        @id @default(cuid())
  number        Int           @unique @default(autoincrement())
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  date          DateTime      @default(now())
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  costTotal     Decimal       @db.Decimal(12, 2)
  paid          Decimal       @db.Decimal(12, 2)
  change        Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  patientName   String?
  doctorName    String?
  note          String?

  items   SaleItem[]
  returns SaleReturn[]

  @@index([date])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id])
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id])
  quantity    Int // base units
  unitPrice   Decimal  @db.Decimal(12, 4)
  unitCost    Decimal  @db.Decimal(12, 4)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  returnedQty Int      @default(0)

  returnItems SaleReturnItem[]
}

model SaleReturn {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  total     Decimal  @db.Decimal(12, 2)
  reason    String?
  createdAt DateTime @default(now())

  items SaleReturnItem[]
}

model SaleReturnItem {
  id         String     @id @default(cuid())
  returnId   String
  return     SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id])
  quantity   Int
  amount     Decimal    @db.Decimal(12, 2)
}

model PurchaseReturn {
  id         String    @id @default(cuid())
  number     Int       @unique @default(autoincrement())
  supplierId String
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  total      Decimal   @db.Decimal(12, 2)
  reason     String?
  createdAt  DateTime  @default(now())

  items PurchaseReturnItem[]
}

model PurchaseReturnItem {
  id       String         @id @default(cuid())
  returnId String
  return   PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  batchId  String
  batch    Batch          @relation(fields: [batchId], references: [id])
  quantity Int // base units
  amount   Decimal        @db.Decimal(12, 2)
}

// Every change to stock is recorded here — the audit trail for inventory.
model StockMovement {
  id         String       @id @default(cuid())
  batchId    String
  batch      Batch        @relation(fields: [batchId], references: [id])
  medicineId String
  medicine   Medicine     @relation(fields: [medicineId], references: [id])
  type       MovementType
  quantity   Int // signed, base units (+ in, - out)
  refId      String? // sale / purchase / return id
  note       String?
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  createdAt  DateTime     @default(now())

  @@index([medicineId, createdAt])
  @@index([createdAt])
}

// Supplier & customer account history (khata).
model LedgerEntry {
  id         String     @id @default(cuid())
  supplierId String?
  supplier   Supplier?  @relation(fields: [supplierId], references: [id])
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  type       LedgerType
  amount     Decimal    @db.Decimal(12, 2) // signed change to the party balance
  balance    Decimal    @db.Decimal(12, 2) // party balance after this entry
  refId      String?
  note       String?
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  createdAt  DateTime   @default(now())

  @@index([supplierId, createdAt])
  @@index([customerId, createdAt])
}

model Expense {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  category  String // Rent, Salary, Electricity...
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([date])
}
